# OpenAI-compatible LLM 配置。
# default 使用下面的端点；命名配置档从 model-profiles/.env.<名字> 单独读取。
# CROSSCOMPLY_LLM_PROFILE=default
# DeepSeek 官方 OpenAI-compatible 地址：
# https://api-docs.deepseek.com/
OPENAI_COMPATIBLE_BASE_URL=https://api.deepseek.com
OPENAI_COMPATIBLE_API_KEY=sk-your-deepseek-api-key
OPENAI_COMPATIBLE_MODEL=deepseek-flash
OPENAI_COMPATIBLE_BETA_BASE_URL=https://api.deepseek.com/beta
OPENAI_COMPATIBLE_STRUCTURED_OUTPUT=strict_tool
# 可选值：none / low / high / max。强制指定工具的 strict_tool 调用使用 none。
OPENAI_COMPATIBLE_REASONING_EFFORT=none
# 主 Agent、案件追问与独立语义核验使用 JSON 输出，可分别配置思考强度。
LAWAGENT_AGENT_REASONING_EFFORT=low
# 正式核验独立模型；留空时继承审查任务的 model_id。
LAWAGENT_SEMANTIC_MODEL=deepseek-v4-pro
LAWAGENT_SEMANTIC_REASONING_EFFORT=low
OPENAI_COMPATIBLE_TIMEOUT_SECONDS=60
# 核验内部流式请求的读取空闲超时与单次请求总时限。
OPENAI_COMPATIBLE_READ_TIMEOUT_SECONDS=60
OPENAI_COMPATIBLE_TOTAL_TIMEOUT_SECONDS=120
# 连接中断（TLS 握手失败等）时最多重试多久（秒）。
OPENAI_COMPATIBLE_CONNECT_RETRY_SECONDS=45

# 审查工作流重试次数。
LAWAGENT_LLM_MAX_RETRIES=3
LAWAGENT_LLM_FACT_RETRIES=3
LAWAGENT_LLM_QUERY_RETRIES=3
LAWAGENT_LLM_EVIDENCE_CHECK_RETRIES=3
LAWAGENT_LLM_RESULT_RETRIES=3

# pgvector service 检索使用的 Embedding 配置。
# 当前项目 service 模式默认使用 SiliconFlow BGE-M3。
EMBEDDING_PROVIDER=openai_compatible
EMBEDDING_BASE_URL=https://api.siliconflow.cn/v1
EMBEDDING_API_KEY=sk-your-embedding-api-key
EMBEDDING_MODEL=BAAI/bge-m3
EMBEDDING_DIM=1024
EMBEDDING_TIMEOUT_SECONDS=60
# 429/5xx/网络错误时最多重试多久（秒）。
EMBEDDING_RETRY_SECONDS=30

# 融合后的 cross-encoder 重排，默认开启；留空的项继承 Embedding 的地址、密钥，模型按 Embedding 配对（bge-m3 → bge-reranker-v2-m3）。
# 关闭：RERANK_MODE=off。重排接口失败时检索退回融合排序，不中断审查。
RERANK_MODE=cross_encoder
RERANK_BASE_URL=
RERANK_API_KEY=
RERANK_MODEL=
RERANK_TIMEOUT_SECONDS=60
RERANK_WINDOW=50
RERANK_BLEND_WEIGHT=0.7

# 受控 Web 调查（Exa）：Agent 只在受控法律库不足时读取官方公开网页。
# 只有这一项需要配置；未填写时该能力对 Agent 报告为不可用，不影响正常审查。
EXA_API_KEY=

# Elasticsearch 关键词检索服务。
ES_URL=http://localhost:9200
ES_INDEX=lawagent_chunks
ES_API_KEY=
ES_VERIFY_CERTS=true

# PostgreSQL + pgvector 向量检索服务。
# 宿主机运行后端时，连接串中的密码必须与 POSTGRES_PASSWORD 保持一致。
PG_DSN=postgresql://lawagent:change-this-postgres-password@localhost:5432/lawagent
PG_TABLE=lawagent_chunks
POSTGRES_PASSWORD=change-this-postgres-password

# CrossComply 企业工作台。首个管理员通过 bootstrap_admin 命令显式创建。
CROSSCOMPLY_SESSION_TTL_HOURS=12
CROSSCOMPLY_MODEL_BOUNDARY=enterprise-approved-api
# 会话 Cookie 的 Secure 标记；留空时按请求是否为 HTTPS（含 X-Forwarded-Proto）自动判断。
# CROSSCOMPLY_COOKIE_SECURE=true

# 对象存储（SeaweedFS，S3 协议）：材料原件与决策报告。Compose 用 S3_* 启动 SeaweedFS，
# 应用用 CROSSCOMPLY_S3_* 连接；宿主机开发时 SeaweedFS 的 S3 端口映射到 localhost:9000。
S3_ACCESS_KEY=crosscomply
S3_SECRET_KEY=change-this-s3-secret
S3_BUCKET=crosscomply-materials
SEAWEEDFS_IMAGE=chrislusf/seaweedfs:3.80
# 总容量约为 SEAWEEDFS_VOLUME_MAX × SEAWEEDFS_VOLUME_SIZE_LIMIT_MB；不要去掉上限，否则可能占满磁盘。
SEAWEEDFS_VOLUME_SIZE_LIMIT_MB=64
SEAWEEDFS_VOLUME_MAX=20
CROSSCOMPLY_S3_ENDPOINT=localhost:9000
CROSSCOMPLY_S3_ACCESS_KEY=crosscomply
CROSSCOMPLY_S3_SECRET_KEY=change-this-s3-secret
CROSSCOMPLY_S3_BUCKET=crosscomply-materials
CROSSCOMPLY_S3_SECURE=false

# 飞书审批（不使用时可留空）。
CROSSCOMPLY_FEISHU_APP_ID=
CROSSCOMPLY_FEISHU_APP_SECRET=
CROSSCOMPLY_FEISHU_APPROVAL_CODE=
CROSSCOMPLY_FEISHU_INITIATOR_OPEN_ID=
CROSSCOMPLY_FEISHU_RECHECK_OPEN_ID=
# Optional JSON map of CrossComply login names to Feishu bot open_id values.
CROSSCOMPLY_FEISHU_WORK_RECIPIENTS=
CROSSCOMPLY_WORK_REVIEWER_USERNAME=
CROSSCOMPLY_FEISHU_VERIFICATION_TOKEN=
CROSSCOMPLY_FEISHU_ENCRYPT_KEY=
CROSSCOMPLY_PUBLIC_BASE_URL=http://127.0.0.1:8080

# ---------------------------------------------------------------------------
# 以下均为可选项，保持注释即使用默认值。
# ---------------------------------------------------------------------------
# Worker 标识与轮询间隔（默认 主机名-PID / 2 秒）。
# CROSSCOMPLY_WORKER_ID=
# CROSSCOMPLY_WORKER_POLL_SECONDS=2
# CROSSCOMPLY_ENRICHMENT_WORKER_ID=
# PDF 决策报告字体；默认使用仓库 docker/fonts/ 中的 Noto Sans SC。
# CROSSCOMPLY_REPORT_FONT=
# CROSSCOMPLY_REPORT_FONT_BOLD=
# 审查 Agent 的 run_python 沙箱：解压后的 CPython WASI 目录（含 python.wasm 与 lib/）。
# LAWAGENT_WASI_PYTHON_ROOT=
# Docling 远程 OCR（数据治理流水线解析扫描件时使用；默认本地 RapidOCR）。
# LAWAGENT_DOCLING_OCR_ENGINE=kserve_v2_ocr
# LAWAGENT_DOCLING_OCR_API_URL=

# 前端变量不在这里配置：Vite 只读取 frontend/ 目录下的 .env*。
# 开发时 /api 默认代理到 127.0.0.1:8000；需要直连其他地址时写入 frontend/.env.local：
#   VITE_API_BASE_URL=http://127.0.0.1:8000
